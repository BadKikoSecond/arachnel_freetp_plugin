# Mirror of Arachnel .github/workflows/release.yml — keep in sync when cutting releases.
QT_VERSION=6.8.2
QT_WINDOWS_ARCH=win64_msvc2022_64
QT_LINUX_ARCH=linux_gcc_64
QT_MODULES=qtshadertools qtmultimedia
BUILD_TYPE=Release
# Git tag of the matching Arachnel GitHub release (SDK + plugin API ABI).
ARACHNEL_SDK_REF=v0.1.13
